---
interface Props {
  name: string;
  alt: string;
  width: number;
  height: number;
  mobile?: { width: number; height: number };
  class?: string;
}

const { name, alt, width, height, mobile, class: className } = Astro.props;
const base = `/img/landing/screenshots/${name}`;
---

<picture>
  {
    mobile && (
      <source
        media="(max-width: 639px)"
        srcset={`${base}-mobile@1x.webp 1x, ${base}-mobile@2x.webp 2x`}
        width={mobile.width}
        height={mobile.height}
      />
    )
  }
  <img
    src={`${base}@1x.webp`}
    srcset={`${base}@1x.webp 1x, ${base}@2x.webp 2x`}
    alt={alt}
    width={width}
    height={height}
    class:list={['w-full', className]}
    loading="lazy"
    decoding="async"
  />
</picture>
