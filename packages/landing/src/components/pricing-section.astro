---
const CHECK =
  '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary mt-0.5 size-4 shrink-0"><path d="M20 6 9 17l-5-5"/></svg>';

const plans = [
  {
    name: 'Essential',
    tagline: 'Manual entry and everything that is local math.',
    yearly: 30,
    monthly: 5,
    features: [
      'Imports: CSV, OFX, YNAB, Wallet, MS Money',
      'Investments, loans, vehicles, venture',
      'AI features with your own API key',
      'Backup export and restore',
      'MCP server for AI agents',
      '2 household seats',
    ],
  },
  {
    name: 'Plus',
    tagline: 'Everything around bring-your-own bank connections.',
    yearly: 55,
    monthly: 8,
    highlight: true,
    features: [
      'Everything in Essential',
      'Bank sync: SimpleFIN, Enable Banking, Monobank, LunchFlow, Walutomat',
      'AI features on our key, no setup',
      '5 household seats',
    ],
  },
  {
    name: 'Premium',
    tagline: 'Bank connections we run for you.',
    planned: true,
    features: [
      'Everything in Plus',
      'Built-in bank sync, no provider account needed',
      'Real-time security prices',
      'Higher AI usage cap',
      '10 household seats',
    ],
  },
];
---

<section id="pricing" class="relative z-10 py-16 sm:py-24">
  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-2xl font-bold tracking-tight sm:text-3xl">Simple pricing</h2>
      <p class="text-muted-foreground mt-4 text-lg">
        40-day free trial of every cloud feature, no card needed. Self-hosting is free, forever.
      </p>
    </div>

    <div class="mt-16 grid gap-6 lg:grid-cols-3">
      {
        plans.map((plan) => (
          <div
            class:list={[
              'border-border/50 bg-card relative flex flex-col rounded-2xl border p-6',
              plan.highlight && 'border-primary/50 shadow-primary/10 shadow-lg',
            ]}
          >
            {plan.highlight && (
              <span class="bg-primary text-primary-foreground absolute -top-3 left-6 rounded-full px-3 py-1 text-xs font-semibold">
                Most popular
              </span>
            )}
            {plan.planned && (
              <span class="border-border text-muted-foreground absolute -top-3 left-6 rounded-full border bg-background px-3 py-1 text-xs font-semibold">
                Planned
              </span>
            )}
            <h3 class="text-lg font-semibold">{plan.name}</h3>
            <p class="text-muted-foreground mt-1 text-sm">{plan.tagline}</p>
            <div class="mt-6">
              {plan.planned ? (
                <span class="text-3xl font-bold">Price TBD</span>
              ) : (
                <>
                  <span class="text-3xl font-bold">${plan.yearly}</span>
                  <span class="text-muted-foreground">/year</span>
                  <span class="text-muted-foreground block text-sm">or ${plan.monthly}/month</span>
                </>
              )}
            </div>
            <ul class="mt-6 space-y-3">
              {plan.features.map((feature) => (
                <li class="flex items-start gap-2 text-sm">
                  <Fragment set:html={CHECK} />
                  <span>{feature}</span>
                </li>
              ))}
            </ul>
            <div class="mt-auto pt-8">
              {plan.planned ? (
                <a
                  href="https://moneymatter.featurebase.app/dashboard/roadmap"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="border-border hover:bg-accent flex w-full items-center justify-center rounded-xl border px-6 py-3 font-semibold transition-all"
                  data-track="landing_roadmap_clicked"
                  data-track-location="pricing"
                >
                  Vote on the roadmap
                </a>
              ) : (
                <a
                  href="/sign-up"
                  class:list={[
                    'flex w-full items-center justify-center rounded-xl px-6 py-3 font-semibold transition-all',
                    plan.highlight
                      ? 'bg-primary text-primary-foreground hover:bg-primary/90'
                      : 'border-border hover:bg-accent border',
                  ]}
                  data-track="landing_cta_clicked"
                  data-track-location="pricing"
                >
                  Start free trial
                </a>
              )}
            </div>
          </div>
        ))
      }
    </div>

    <p class="text-muted-foreground mt-8 text-center text-sm">
      Prices in USD. Taxes are calculated at checkout. Cancel anytime.
    </p>
  </div>
</section>
