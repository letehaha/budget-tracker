---
import { GITHUB_URL } from '@/lib/github-api';
import { getRecentReleases } from '@/lib/github-releases';

const releases = await getRecentReleases({ limit: 3 });

const ARROW =
  '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-3.5"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>';

const cards = [
  {
    title: 'Request a feature',
    text: "Tell us what you need. If others agree, they upvote it, and it moves up the roadmap.",
    cta: 'Give feedback',
    href: 'https://moneymatter.featurebase.app',
    track: 'landing_roadmap_clicked',
    // Lightbulb
    icon: '<path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"/><path d="M9 18h6"/><path d="M10 22h4"/>',
  },
  {
    title: 'See what just shipped',
    text: 'New features, improvements and fixes ship every week. Every update is documented.',
    releases,
    cta: 'Read the changelog',
    href: `${GITHUB_URL}/releases`,
    track: 'landing_github_clicked',
    // Rocket
    icon: '<path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/><path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/><path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"/><path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/>',
  },
  {
    title: 'Read the code',
    text: 'Everything is open source under AGPL-3.0. Audit how your data is handled, open an issue, or send a pull request.',
    cta: 'View on GitHub',
    href: GITHUB_URL,
    track: 'landing_github_clicked',
    // Code
    icon: '<path d="m16 18 6-6-6-6"/><path d="m8 6-6 6 6 6"/>',
  },
];
---

<section id="community" class="relative z-10 py-16 sm:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-2xl font-bold tracking-tight sm:text-3xl">Built in the open</h2>
      <p class="text-muted-foreground mt-4 text-lg">
        One developer, a public roadmap, and a changelog you can check. Your feedback decides what gets built next.
      </p>
    </div>

    <div class="mt-12 grid gap-6 md:grid-cols-[8fr_9fr_8fr]">
      {
        cards.map((card) => (
          <a
            href={card.href}
            target="_blank"
            rel="noopener noreferrer"
            class="group border-border/50 bg-card hover:border-primary/50 flex min-w-0 flex-col rounded-2xl border p-6 transition-all hover:shadow-lg"
            data-track={card.track}
            data-track-location="community"
          >
            <div class="bg-primary/10 text-primary mb-4 flex size-12 items-center justify-center rounded-xl">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-6" set:html={card.icon} />
            </div>
            <h3 class="mb-2 text-lg font-semibold">{card.title}</h3>
            {card.releases?.length ? (
              <ul class="divide-border/50 divide-y text-sm">
                {card.releases.map((release) => (
                  <li class="flex items-baseline gap-2 py-1.5">
                    <span class="text-foreground shrink-0 font-mono text-xs">{release.version}</span>
                    <span class="text-muted-foreground min-w-0 flex-1 truncate">{release.title}</span>
                    <span class="text-muted-foreground/70 shrink-0 text-xs">{release.publishedOn}</span>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="text-muted-foreground text-sm">{card.text}</p>
            )}
            <span class="text-primary mt-auto inline-flex items-center gap-1 pt-4 text-sm font-medium">
              {card.cta}
              <Fragment set:html={ARROW} />
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>
