---
import { existsSync } from 'node:fs';
import { join } from 'node:path';

interface Props {
  src: string;
  alt: string;
  /** Capture instructions, shown only in dev while the image file is missing. */
  hint: string;
  caption?: string;
}

const { src, alt, hint, caption } = Astro.props;
const inPublic = (path: string) => existsSync(join(process.cwd(), 'public', path));
const lightSrc = inPublic(src) ? src : undefined;
const dark = src.replace(/\.png$/, '.dark.png');
const darkSrc = lightSrc && inPublic(dark) ? dark : undefined;
// Missing screenshots are hidden in production builds so placeholders never reach readers.
const render = lightSrc || import.meta.env.DEV;
---

{
  render && (
    <figure class="screenshot">
      {darkSrc ? (
        <>
          <img class="dark:sl-hidden" src={lightSrc} alt={alt} loading="lazy" />
          <img class="light:sl-hidden" src={darkSrc} alt={alt} loading="lazy" />
        </>
      ) : lightSrc ? (
        <img src={lightSrc} alt={alt} loading="lazy" />
      ) : (
        <div class="screenshot-placeholder">
          <strong>Screenshot needed: {src}</strong>
          <span>{alt}</span>
          <em>{hint}</em>
        </div>
      )}
      {caption && <figcaption>{caption}</figcaption>}
    </figure>
  )
}

<style>
  .screenshot img {
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
  }
  .screenshot figcaption {
    margin-top: 0.5rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
  .screenshot-placeholder {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1rem;
    border: 2px dashed var(--sl-color-accent);
    border-radius: 0.5rem;
    font-size: var(--sl-text-sm);
  }
</style>
